# =============================================================================
# Philos EduOS — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# -----------------------------------------------------------------------------
# Supabase (Database + Auth + Storage)
# -----------------------------------------------------------------------------
# Get these from https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database connection string (from Supabase Dashboard → Settings → Database)
# Use the connection pooler (port 6543) for serverless environments
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Service role key (from Supabase Dashboard → Settings → API → service_role)
# Used in server-side API routes — NEVER expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Resend (Email)
# -----------------------------------------------------------------------------
# Get from https://resend.com/api-keys (free tier: 100 emails/day)
RESEND_API_KEY=re_your_api_key

# -----------------------------------------------------------------------------
# Paystack (Payments — optional)
# -----------------------------------------------------------------------------
# Get from https://dashboard.paystack.com → Settings → API Keys
PAYSTACK_SECRET_KEY=sk_test_your_key

# Public site URL (used in Paystack redirects)
SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Anthropic (AI Report Comments — optional)
# -----------------------------------------------------------------------------
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=
