# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Server-side secrets — set these as Convex environment variables, never in a
# client bundle or committed file.
# AI report-card comments (see src/convex/reportComments.ts)
ANTHROPIC_API_KEY=

# Paystack payments (see src/convex/payments.ts and src/convex/http.ts)
PAYSTACK_SECRET_KEY=

# Public site URL used in Paystack redirects (see src/convex/payments.ts)
SITE_URL=http://localhost:5173
